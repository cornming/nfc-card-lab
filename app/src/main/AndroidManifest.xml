<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />

    <!--
        網路權限只用在「HTTP POST」動作：你替某張卡設定了 POST 網址，刷卡時才會連線。
        沒有設定 POST 動作就不會有任何網路連線；沒有遙測、沒有更新檢查。
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 不強制要求 NFC，沒有 NFC 的手機也能安裝，App 內會顯示說明。 -->
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!--
        允許明碼 http 只是為了連區域網路裡的服務（例如自架的 Home Assistant）。
        實際可連的位址由程式裡的 UrlPolicy 限制：http 只能連私有網段、localhost、*.local。
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                沒有這組 intent-filter 時，App 只有在「已經開著且在前景」才能讀卡
                （靠 MainActivity 裡的 enableReaderMode）。手機解鎖後、App 還沒開啟前刷卡，
                系統就只會把 App 叫起來，卡片資料不會送進來，要等使用者再刷第二次才會成功。
                加上這組之後，App 不在前景時系統也會把卡片資料透過這個 Intent 一併送進來，
                MainActivity 的 onCreate／onNewIntent 會立刻處理，不需要刷兩次。
            -->
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>
    </application>

</manifest>
